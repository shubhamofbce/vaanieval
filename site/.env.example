NEXT_PUBLIC_SITE_URL=https://www.vaanieval.com
NEXT_PUBLIC_APP_URL=https://app.vaanieval.com

# Server-only URL for the deployed VaaniEval API. Waitlist submissions are proxied
# through the public site and stored by this API, never exposed to the browser.
VAANIEVAL_API_URL=https://api.example.com
WAITLIST_INGEST_TOKEN=replace-with-a-long-random-secret
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# Paste verification tokens only, not complete HTML tags.
GOOGLE_SITE_VERIFICATION=replace-with-google-search-console-token
BING_SITE_VERIFICATION=replace-with-bing-webmaster-token

# Optional analytics. Scripts remain disabled while values are placeholders.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=XXXXXXXXXX
